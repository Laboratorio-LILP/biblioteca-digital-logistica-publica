# Configuração do front-controller (index.php) de homologação.
# Copie para .env no diretório do edge (ex.: /opt/lampp/htdocs/.env na VM).
#
# Mapa de sistemas → porta loopback do portal Django de cada frente do LILP.
# Formato: Nome:porta,Nome:porta  (o nome é o sub-path; a porta é 127.0.0.1:<porta>).
# Registrar uma frente nova = adicionar uma entrada aqui.
DJANGO_PROJECTS=Biblioteca:8010
# Exemplo com várias frentes:
# DJANGO_PROJECTS=Biblioteca:8010,OutroSistema:8011
