# ─────────────────────────────────────────────────────────────────────────────
# Configuração do stack BDLP. Copie para `.env` (raiz) e ajuste. O Makefile usa
# `--env-file .env` (este arquivo, na raiz) — é a FONTE ÚNICA de configuração.
# `.env` é gitignored. NUNCA commitar segredos reais; aqui só placeholders.
#
# Matriz por estágio (ver docs/DEPLOY.md):
#                    dev          homologação        produção (Prodesp/TLS)
#   DJANGO_DEBUG     true         false              false
#   SECURE_SSL       false        false (HTTP)       true (HTTPS)
#   ALLOWED_HOSTS    localhost    host(s) da VM      domínio público
#   FORCE_SCRIPT_NAME (vazio)     /Biblioteca        conforme borda
# ─────────────────────────────────────────────────────────────────────────────

# Portas expostas no host (loopback). Trocar em caso de conflito.
# Ex.: em algumas máquinas Windows a 8000 é reservada pelo kernel → PORTAL_PORT=8001.
POSTGRES_PORT=5432
NOURAU_PORT=8080
PORTAL_PORT=8000

# Credenciais do Postgres. `php` = admin (schema/seed); `portal_reader` = role
# read-only que o Django consome. Trocar por valores fortes fora do laptop.
POSTGRES_DB=nourau
POSTGRES_USER=php
POSTGRES_PASSWORD=changeme_postgres
PORTAL_DB_USER=portal_reader
PORTAL_DB_PASSWORD=changeme_portal_reader

# Django (portal). Gerar a SECRET_KEY:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_URL=http://localhost:8000

# Endurecimento que EXIGE HTTPS (cookies Secure, redirect SSL, HSTS).
# DEBUG e HTTPS são desacoplados: DEBUG=false sozinho NÃO liga estas flags.
# true SOMENTE com TLS na frente (produção). Em HTTP (homologação :80) deixe false.
SECURE_SSL=false

# Proxy reverso / subcaminho. Vazio em dev (portal na raiz). Na VM/homologação:
# FORCE_SCRIPT_NAME=/Biblioteca
# CSRF_TRUSTED_ORIGINS=http://<host-publico>,https://<host-publico>
# (ALLOWED_HOSTS acima deve incluir o <host-publico>)

# Nou-Rau (backend de curadoria).
NOURAU_SITE_URL=http://localhost:8080
NOURAU_WEBMASTER_EMAIL=nourau@localhost
NOURAU_ADMIN_EMAIL=nourau@localhost.com
NOURAU_SITE_TITLE=Biblioteca Digital de Logística Pública

# Produção com Caddy (docker-compose.prod.yml): domínio público (ou sslip.io).
# DOMAIN=biblioteca.exemplo.sp.gov.br
