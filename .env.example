# PostgreSQL
POSTGRES_DB=nourau
POSTGRES_USER=php
POSTGRES_PASSWORD=changeme_nourau_2026
PORTAL_DB_USER=portal_reader
PORTAL_DB_PASSWORD=changeme_portal_2026

# Nou-Rau
NOURAU_SITE_URL=http://localhost:8080
NOURAU_ADMIN_EMAIL=nourau@localhost.com
NOURAU_SITE_TITLE=Biblioteca Digital de Logística Pública

# Django Portal
DJANGO_SECRET_KEY=changeme-generate-a-real-secret-key
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
PORTAL_URL=http://localhost:8000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Proxy reverso / subcaminho (VM atrás do index.php). Vazio em dev local.
# FORCE_SCRIPT_NAME=/Biblioteca
# CSRF_TRUSTED_ORIGINS=https://<host-publico>
# (ALLOWED_HOSTS acima deve incluir o <host-publico>)

# Túnel de homologação sem VPN (make tunnel — ver docs/tunel-homologacao.md).
# Enquanto o túnel estiver em uso: DJANGO_DEBUG=false e as duas linhas abaixo.
# ALLOWED_HOSTS=localhost,127.0.0.1,.devtunnels.ms
# CSRF_TRUSTED_ORIGINS=https://*.devtunnels.ms
