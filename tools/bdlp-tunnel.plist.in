<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template do LaunchAgent que mantém o túnel de homologação no ar
  (instalado por `make tunnel-service`; @REPO@ e @HOME@ são substituídos).
  KeepAlive reinicia o túnel se ele cair; se o portal estiver fora do ar
  ou o túnel tiver expirado, o tunnel.sh trata e o launchd tenta de novo
  a cada ThrottleInterval segundos.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>br.gov.sp.lilp.bdlp-tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@REPO@/tools/tunnel.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>@REPO@</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>@HOME@/Library/Logs/bdlp-tunnel.log</string>

    <key>StandardErrorPath</key>
    <string>@HOME@/Library/Logs/bdlp-tunnel.log</string>
</dict>
</plist>
