# Caddy v2 — reverse proxy + HTTPS automático (Let's Encrypt).
# Domínio único: cada sistema do LILP é um sub-path ({$APP_PATH}). O portal roda
# sob /{$APP_PATH}/ e recompõe as URLs via FORCE_SCRIPT_NAME (handle_path remove
# o prefixo antes de repassar). {$DOMAIN} e {$APP_PATH} vêm do ambiente
# (docker-compose.prod.yml). sslip.io serve enquanto não houver domínio próprio
# (ex.: <IP>.sslip.io aponta para <IP>).

{$DOMAIN} {
    encode zstd gzip

    # Painel de curadoria do Nou-Rau (PHP/Apache) — RESTRITO, não público.
    # Por padrão libera só loopback; ajuste a allowlist para as faixas da
    # VPN/SGGD antes de habilitar em produção (ver docs/DEPLOY.md › Hardening).
    handle /manager* {
        @allowed remote_ip 127.0.0.1/32 ::1
        handle @allowed {
            reverse_proxy nourau:80
        }
        respond "Acesso restrito ao painel de curadoria." 403
    }

    # Portal Django sob o sub-path do sistema. Inclui /static/* (WhiteNoise).
    handle_path /{$APP_PATH:Biblioteca}/* {
        reverse_proxy portal:8000
    }

    # Raiz → sub-path do sistema.
    redir / /{$APP_PATH:Biblioteca}/ 302

    # Headers de segurança básicos (os do app via django-csp continuam valendo).
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Habilitar HSTS só após validar tudo via HTTPS:
        # Strict-Transport-Security "max-age=31536000; includeSubDomains"
    }

    log {
        output file /var/log/caddy/access.log {
            roll_size 50mb
            roll_keep 5
        }
    }
}
